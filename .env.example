# Chép file này thành .env.local rồi điền key (key chỉ nằm ở máy chủ, không bao giờ gửi xuống trình duyệt)
GEMINI_API_KEY=

# Danh sách model Gemini, thử lần lượt; gặp 404 / 429 / 5xx thì chuyển model kế.
# Muốn dùng model của Antigravity hay model Gemini khác: thêm tên model vào đầu danh sách.
GEMINI_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-2.5-flash

# Số lượt gọi AI tối đa mỗi ngày (key miễn phí ~60 lượt). Máy chủ đếm trong bộ nhớ, trình duyệt cũng đếm riêng.
AI_DAILY_LIMIT=60
